@model List<EmployeeDep.ViewModels.EmployeeWithDepartmentViewModel>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<a asp-controller="Employee"
   asp-action="AddEmployee"
   class="btn btn-primary">
    Add Employee
</a>

<br />
<br />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Job Title</th>
            <th>Department Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Age</td>
                <td>@employee.Salary</td>
                <td>@employee.JobTitle</td>
                <td>@employee.DepartmentName</td>

                <td>

                   <form asp-controller="Employee"
      asp-action="DeleteEmployee"
      asp-route-id="@employee.Id"
      method="post"
      style="display:inline;">

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

</form>

                    <form asp-controller="Employee"
                          asp-action="DeleteEmployee"
                          asp-route-id="@employee.Id"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                    </form>

                </td>
            </tr>
        }

    </tbody>

</table>